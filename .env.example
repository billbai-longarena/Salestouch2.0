# SaleTouch 2.0 环境变量示例
# 复制为 .env 后按需修改

# 数据库
POSTGRES_PASSWORD=change-me

# HTTP
PORT=3000
PUBLIC_URL=http://localhost:3000

# 模型（OpenAI 兼容）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# 知识包目录
KNOWLEDGE_PACK_DIR=./testdata/demo-pack

# 生产环境请设为 true（要求知识包必须带有效签名）
REQUIRE_SIGNED_PACKS=false
